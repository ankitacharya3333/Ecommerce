# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for local PostgreSQL: postgresql://postgres:postgres@localhost:5432/novamarket?schema=public
# Example for Supabase / Neon: postgresql://username:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novamarket?schema=public"

# Authentication Secret
# Generate using: openssl rand -base64 32
AUTH_SECRET="f9a382b7c4d1e6e5a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7"
NEXTAUTH_URL="http://localhost:3000"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional Email (Resend)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=""

# Verified Sender Address (Resend verified domain or onboarding address)
# Example: "NOVA MARKET <concierge@novamarket.design>" or "onboarding@resend.dev"
EMAIL_FROM="NOVA MARKET <onboarding@resend.dev>"

# Administrator Notification Email for client inquiries
ADMIN_EMAIL="rmnrr333@gmail.com"
