# ------------------------------------------------------------------------------
# NOVA MARKET - Production & Local Environment Configuration
# ------------------------------------------------------------------------------

# Database Connection (Managed PostgreSQL / Neon)
# In production on Vercel: Use pooled connection URL for runtime queries.
# If migrations are run directly: DIRECT_URL can be configured.
DATABASE_URL="postgresql://username:password@ep-cool-fog-12345-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://username:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication Session Secret (Mandatory in Production, min 32 characters)
# Generate using: openssl rand -base64 32
AUTH_SECRET="your-secure-random-32-char-minimum-secret-key"

# Application Base URL (Critical for Password Reset Links & Email Callbacks)
# Local: http://localhost:3000
# Production: https://your-production-domain.vercel.app (or custom domain)
NEXT_PUBLIC_APP_URL="https://your-production-domain.vercel.app"

# Transactional Email (Resend)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# Verified Sender Email
# Testing / Default: "NOVA MARKET <onboarding@resend.dev>"
# Production: "NOVA MARKET <concierge@yourverifieddomain.com>"
RESEND_FROM_EMAIL="NOVA MARKET <onboarding@resend.dev>"
EMAIL_FROM="NOVA MARKET <onboarding@resend.dev>"

# Administrator Notification Email
ADMIN_EMAIL="admin@yourdomain.com"

# Initial Admin Account Provisioning (For scripts/provision-admin.ts)
INITIAL_ADMIN_EMAIL="admin@novamarket.design"
INITIAL_ADMIN_PASSWORD="YourSecureAdminPassword2026!"
INITIAL_ADMIN_NAME="Studio Administrator"

# Stripe Payment Provider (Optional / Test Mode)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Alternative Payment Gateways Evaluation (Optional)
ESEWA_MERCHANT_CODE=""
ESEWA_SECRET_KEY=""
KHALTI_PUBLIC_KEY=""
KHALTI_SECRET_KEY=""
